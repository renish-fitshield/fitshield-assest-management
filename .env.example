# MongoDB
MONGODB_URI=mongodb://user:password@host:27017/
MONGODB_DB=fitshield_asset_management

# JWT (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=28800

# Email — asset acknowledgement emails (sent on every assign / transfer / return).
# One SENDING mailbox delivers to everyone (Outlook, Zoho, Gmail, Yopmail inboxes all receive it).
# Check the settings with: npm run mail:test -- someone@yopmail.com
# Without them, development sends to a test inbox (nothing is delivered) and production reports the email as failed.
# MAIL_PROVIDER: zeptomail | microsoft365 (Graph) | outlook | zoho-in | zoho | zoho-eu | gmail   (Yopmail can't send.)
MAIL_PROVIDER=zeptomail
MAIL_FROM="Fitshield Asset Management <jeel.borda@fitshield.in>"
# MAIL_REPLY_TO=

# zeptomail — Zoho ZeptoMail, the service the Fitshield backend already uses (fitshield.in is verified there,
# so any @fitshield.in sender works). SMTP_USER is literally "emailapikey"; SMTP_PASS is a Send Mail token
# (ZeptoMail → Mail Agents → SMTP). Ideally create a separate token for this app.
# SMTP_USER=emailapikey
# SMTP_PASS=

# microsoft365 — Microsoft Graph (fitshield.in mail is on Microsoft 365). From an app registration in Microsoft
# Entra with the Mail.Send application permission (admin consented). The tenant can be the domain itself.
MS_TENANT_ID=fitshield.in
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# outlook / zoho-in / zoho / zoho-eu / gmail — SMTP with the mailbox's (app) password.
# outlook needs "Authenticated SMTP" on for the mailbox, and Microsoft may refuse passwords; gmail needs an App Password.
SMTP_USER=
SMTP_PASS=
# Any other SMTP server: leave MAIL_PROVIDER empty and set these (they also override a provider's defaults).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# Public address of the app, used in the acknowledgement links (defaults to the address the request came in on).
APP_URL=

# Seed user (npm run seed)
SEED_USER_EMAIL=jg@yopmail.com
SEED_USER_PIN=4545
SEED_USER_NAME=JG
SEED_USER_ROLE=Admin
